# ElevenLabs settings for Gary's voice. This file stays on your machine (copy this to .env.local).
# The key is deliberately NOT prefixed with VITE_, so Vite never puts it in the game bundle.

# Your API key: elevenlabs.io → Settings → API Keys
ELEVENLABS_API_KEY=your-key-here

# Voice for Gary: copy a voice ID from elevenlabs.io → Voices (leave blank to pick one later)
ELEVENLABS_VOICE_ID=

# Model: eleven_v3 is the most expressive (acts out [shouting], [sighs]...); eleven_multilingual_v2 is steadier
ELEVENLABS_MODEL_ID=eleven_v3
